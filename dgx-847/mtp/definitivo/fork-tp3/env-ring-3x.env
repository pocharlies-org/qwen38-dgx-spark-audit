# DGX-852: arranque del TP=3 por el triangulo. IDÉNTICO a tp3/recipe/env-ring-3x.env (DGX-847) salvo
# este encabezado: aqui el modelo también es una vista local, así que HF_HOME/HF_HUB_CACHE siguen
# apuntando al cache de dgx1 montado en /cache/huggingface (los tres rangos lo ven: hostPath en dgx1,
# NFS ro en dgx2 y dgx3). NCCL_IB_HCA y NCCL_GRAPH_FILE NO van aqui: los escribe serve-3x.sh con el
# generador del grafo segun el host de ring.conf de cada rango.
#  1) el bootstrap (torch.distributed, gloo, TP) va por la LAN: 10.0.0.2 es la /30 dgx1<->dgx2 y dgx3
#     no la ve. Mismo interfaz y mismo master que el residente TP=3 (enP7s7, spark2).
#  2) la receta NCCL de DGX-817: libnccl.so.2 parcheada de la imagen nccl-ring por volumen de imagen,
#     conexion diferida y solo el anillo. NCCL_CUMEM_ENABLE=0 (el del 2x) no vale en el triangulo: con
#     cuMem a 0 NCCL conecta en el init arboles y PAT y no pueden (ibv_modify_qp 110). Medido en
#     DGX-810/815: 23 GB/s con 256 MiB.
HF_HOME=/cache/huggingface
HF_HUB_CACHE=/cache/huggingface/hub
HF_HUB_OFFLINE=1
XDG_CACHE_HOME=/cache/xdg
OMP_NUM_THREADS=4
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CROSS_NIC=1
NCCL_NET_PLUGIN=none
NCCL_CUMEM_ENABLE=1
NCCL_RUNTIME_CONNECT=1
NCCL_ALGO=Ring
LD_PRELOAD=/opt/nccl-ring/lib/libnccl.so.2
VLLM_NCCL_SO_PATH=/opt/nccl-ring/lib/libnccl.so.2
# Sin UCX_NET_DEVICES ni NCCL_IB_GID_INDEX: el TP=3 medido (DGX-817/820) no los pone; NCCL elige el
# GID RoCE v2 IPv4 y la lista de HCA la da el generador del grafo rango a rango.
NCCL_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
TP_SOCKET_IFNAME=enP7s7
MN_IF_NAME=enP7s7
# 14-10 09:27Z: sin estas cinco (las del residente con el mismo anillo) NCCL junta las mitades de cada puerto y el grafo
# del anillo no casa: "graph/topo.h:269 NCCL WARN Could not find NET with id 1" -> internal error en el primer all-reduce
NCCL_IB_MERGE_NICS=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_AUTO_DETECT=0
NCCL_NVLS_ENABLE=0
