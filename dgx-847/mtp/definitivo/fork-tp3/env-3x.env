# DGX-852: env del fork de ursuciprian en TP=3 con la variante E2. Copia de tp3/recipe/env-3x.env
# (el original de DGX-847 no se toca) con CUATRO cambios y nada más:
#  - MODEL_DIR: la vista universal (PLE NVFP4) de mtp/definitivo/universal/construir-universal.sh;
#    MXFP8_DIR / VLLM_B12X_NVFP4_MXFP8_CHECKPOINT: la copia MXFP8 de construir-vistas.sh. Se ven en los tres rangos por el mismo camino: hostPath en dgx1 y
#    los dos PVC ro de NFS (dgx2: hf-cache-nvidia-dgx-ro, dgx3: hf-cache-dgx1-dgx3-llm-ro), todos con
#    raiz /home/dibanerz/.cache/huggingface montada en /cache/huggingface. No hace falta copiar nada
#    a dgx3 (lo hace el residente hoy mismo con esa PVC).
#  - VLLM_GDN_DEFERRED_CHECKPOINTS=0: E2 lleva el GDN en triton, y `gdn_deferred_commit.resolve()`
#    solo admite los checkpoints diferidos con b12x en decode Y prefill; con 1 aborta (fail-closed).
#  - VLLM_GDN_COMPACT_RECORDS=0: es la pareja del anterior (la receta 1x lo trae a 1 y exige el GDN
#    b12x; en E2 se apaga como hizo ops/prueba-e2.sh).
#  - VLLM_MTP_DRAFT_VOCAB: el vocabulario del borrador en castellano, montado del ConfigMap
#    llm/qwen38fn-mtp-draft-vocab en /opt/mtp-vocab-es (ids ∈ [0, 248320), que es lo que exige
#    `load_draft_vocab_ids(path, config.vocab_size)`).
MODEL_DIR=/cache/huggingface/qwen38fn-mtp-ursu-universal
MXFP8_DIR=/cache/huggingface/qwen38fn-mtp-ursu-mxfp8-tp3
VLLM_B12X_NVFP4_MXFP8_MIN_TOKENS=41
VLLM_B12X_NVFP4_MXFP8_CHECKPOINT=/cache/huggingface/qwen38fn-mtp-ursu-mxfp8-tp3
VLLM_QWEN38_HC_MXFP8=hc
VLLM_GDN_UNIFORM_DECODE_META_SKIP=1
B12X_AUTOTUNE=1
B12X_ROCE_SPIN_LIMIT=300000000
CUTE_DSL_ARCH=sm_121a
SAFETENSORS_FAST_GPU=1
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_SSM_CONV_STATE_LAYOUT=DS
VLLM_USE_AOT_COMPILE=1
VLLM_USE_MEGA_AOT_ARTIFACT=1
VLLM_USE_V2_MODEL_RUNNER=1
B12X_POLICY_MODE=auto
VLLM_ENABLE_ROCE_ALLREDUCE=0
VLLM_ROCE_ALLREDUCE_MAX_SIZE=2MB
VLLM_MXFP8_LM_HEAD=1
B12X_COMPILE_WORKERS=2
VLLM_GDN_DEFERRED_CHECKPOINTS=0
VLLM_GDN_COMPACT_RECORDS=0
VLLM_PREFIX_DROP_EXACT=1
VLLM_MTP_DRAFT_VOCAB=/opt/mtp-vocab-es/ids-es-K131072.txt.gz
