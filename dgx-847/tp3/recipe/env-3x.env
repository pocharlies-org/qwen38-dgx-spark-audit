# DGX-847: env de la receta de ursuciprian en TP=3. Igual que env-2x.env menos tres cosas:
#  - MODEL_DIR / MXFP8_DIR: la vista TP=3 del checkpoint (la produce el Job de CONVERTIR.md);
#  - VLLM_ENABLE_ROCE_ALLREDUCE=0: su one-shot monta la malla por INDICE de HCA (_roce_proxy.c:302 usa
#    peer->gid[h]) y el triangulo dgx1P0-dgx2P0 / dgx1P1-dgx3P0 / dgx2P1-dgx3P1 no la da; con 0 el
#    communicator cae limpio a PYNCCL (cuda_communicator.py:76, pynccl se construye siempre con world>1);
#  - nada mas cambia: MTP=4, draft vocab, HC mxfp8, autotune y prefijos son los de la receta 2x.
MODEL_DIR=/cache/huggingface/tp3/ursu-qwen38fn-tp3
MXFP8_DIR=/cache/huggingface/tp3/ursu-mxfp8-tp3
VLLM_B12X_NVFP4_MXFP8_MIN_TOKENS=41
VLLM_B12X_NVFP4_MXFP8_CHECKPOINT=/cache/huggingface/tp3/ursu-mxfp8-tp3
VLLM_QWEN38_HC_MXFP8=hc
VLLM_GDN_UNIFORM_DECODE_META_SKIP=1
B12X_AUTOTUNE=1
B12X_ROCE_SPIN_LIMIT=300000000
CUTE_DSL_ARCH=sm_121a
SAFETENSORS_FAST_GPU=1
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_SSM_CONV_STATE_LAYOUT=DS
VLLM_USE_AOT_COMPILE=1
VLLM_USE_MEGA_AOT_ARTIFACT=1
VLLM_USE_V2_MODEL_RUNNER=1
B12X_POLICY_MODE=auto
VLLM_ENABLE_ROCE_ALLREDUCE=0
VLLM_ROCE_ALLREDUCE_MAX_SIZE=2MB
VLLM_MXFP8_LM_HEAD=1
B12X_COMPILE_WORKERS=2
VLLM_GDN_DEFERRED_CHECKPOINTS=1
VLLM_PREFIX_DROP_EXACT=1
VLLM_MTP_DRAFT_VOCAB=/opt/mtp-vocab/ids-v2-K131072.txt.gz
