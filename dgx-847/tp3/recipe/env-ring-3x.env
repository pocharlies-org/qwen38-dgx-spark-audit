# DGX-847: env de arranque del TP=3 por el triangulo. Sale de env-sparkrun-2x.env con dos cambios de fondo:
#  1) el bootstrap (torch.distributed, gloo, TP) va por la LAN: 10.0.0.2 es la /30 dgx1<->dgx2 y dgx3 no la ve.
#     Mismo interfaz y mismo master que el residente TP=3 (enP7s7, spark2; medido DGX-817/820).
#  2) la receta NCCL de DGX-817 (overlays/qwen38-tp3-ventana-20261010/patch-nccl-ring.yaml): libnccl.so.2
#     parcheada de nccl-ring por volumen de imagen, conexion diferida y solo el anillo. NCCL_IB_HCA y
#     NCCL_GRAPH_FILE NO van aqui: los escribe serve-3x.sh con el generador segun el host de ring.conf.
# NCCL_CUMEM_ENABLE=0 (el del 2x) no vale en el triangulo: con cuMem a 0 NCCL conecta en el init arboles y PAT
# y en el triangulo no pueden (ibv_modify_qp 110). Medido en DGX-810/815: 23 GB/s con 256 MiB.
HF_HOME=/cache/huggingface
HF_HUB_CACHE=/cache/huggingface/hub
HF_HUB_OFFLINE=1
XDG_CACHE_HOME=/cache/xdg
OMP_NUM_THREADS=4
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CROSS_NIC=1
NCCL_NET_PLUGIN=none
NCCL_CUMEM_ENABLE=1
NCCL_RUNTIME_CONNECT=1
NCCL_ALGO=Ring
LD_PRELOAD=/opt/nccl-ring/lib/libnccl.so.2
VLLM_NCCL_SO_PATH=/opt/nccl-ring/lib/libnccl.so.2
# Sin UCX_NET_DEVICES ni NCCL_IB_GID_INDEX: el TP=3 medido (DGX-817/820) no los pone; NCCL elige el GID RoCE v2
# IPv4 y la lista de HCA la da el generador del grafo rango a rango.
NCCL_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
TP_SOCKET_IFNAME=enP7s7
MN_IF_NAME=enP7s7
