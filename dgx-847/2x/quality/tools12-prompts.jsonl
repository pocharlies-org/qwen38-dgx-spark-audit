{"kind": "tool", "id": "t01", "prompt": "What is the weather in Madrid right now?", "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Current weather for a city", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name"}}, "required": ["city"]}}}], "expect": "get_weather"}
{"kind": "tool", "id": "t02", "prompt": "Convert 250 US dollars to euros.", "tools": [{"type": "function", "function": {"name": "convert_currency", "description": "Convert an amount between currencies", "parameters": {"type": "object", "properties": {"amount": {"type": "number", "description": "Amount"}, "from": {"type": "string", "description": "ISO code"}, "to": {"type": "string", "description": "ISO code"}}, "required": ["amount", "from", "to"]}}}], "expect": "convert_currency"}
{"kind": "tool", "id": "t03", "prompt": "Set a timer for 12 minutes called pasta.", "tools": [{"type": "function", "function": {"name": "set_timer", "description": "Start a countdown timer", "parameters": {"type": "object", "properties": {"minutes": {"type": "number", "description": "Duration in minutes"}, "label": {"type": "string", "description": "Timer label"}}, "required": ["minutes"]}}}], "expect": "set_timer"}
{"kind": "tool", "id": "t04", "prompt": "Search the web for the latest vLLM release notes.", "tools": [{"type": "function", "function": {"name": "web_search", "description": "Search the web", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "Search query"}}, "required": ["query"]}}}], "expect": "web_search"}
{"kind": "tool", "id": "t05", "prompt": "Send an email to ana@example.com saying the build is green.", "tools": [{"type": "function", "function": {"name": "send_email", "description": "Send an email", "parameters": {"type": "object", "properties": {"to": {"type": "string", "description": "Recipient"}, "subject": {"type": "string", "description": "Subject"}, "body": {"type": "string", "description": "Body"}}, "required": ["to", "body"]}}}], "expect": "send_email"}
{"kind": "tool", "id": "t06", "prompt": "Read the file /etc/hostname.", "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a text file", "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Absolute path"}}, "required": ["path"]}}}], "expect": "read_file"}
{"kind": "tool", "id": "t07", "prompt": "Add a calendar event on 2026-11-03 at 10:00 titled Sprint review.", "tools": [{"type": "function", "function": {"name": "create_event", "description": "Create a calendar event", "parameters": {"type": "object", "properties": {"date": {"type": "string", "description": "YYYY-MM-DD"}, "time": {"type": "string", "description": "HH:MM"}, "title": {"type": "string", "description": "Title"}}, "required": ["date", "title"]}}}], "expect": "create_event"}
{"kind": "tool", "id": "t08", "prompt": "How many orders did we ship yesterday?", "tools": [{"type": "function", "function": {"name": "query_orders", "description": "Count orders by status and day", "parameters": {"type": "object", "properties": {"status": {"type": "string", "description": "Order status"}, "day": {"type": "string", "description": "YYYY-MM-DD or 'yesterday'"}}, "required": ["status"]}}}], "expect": "query_orders"}
{"kind": "tool", "id": "t09", "prompt": "Translate 'good morning' into Japanese.", "tools": [{"type": "function", "function": {"name": "translate", "description": "Translate text", "parameters": {"type": "object", "properties": {"text": {"type": "string", "description": "Text"}, "target_language": {"type": "string", "description": "Target language"}}, "required": ["text", "target_language"]}}}], "expect": "translate"}
{"kind": "tool", "id": "t10", "prompt": "Restart the service named gateway in staging.", "tools": [{"type": "function", "function": {"name": "restart_service", "description": "Restart a service", "parameters": {"type": "object", "properties": {"name": {"type": "string", "description": "Service name"}, "environment": {"type": "string", "description": "Environment"}}, "required": ["name"]}}}], "expect": "restart_service"}
{"kind": "tool", "id": "t11", "prompt": "Look up the stock price of NVDA.", "tools": [{"type": "function", "function": {"name": "get_stock_price", "description": "Latest stock price", "parameters": {"type": "object", "properties": {"ticker": {"type": "string", "description": "Ticker symbol"}}, "required": ["ticker"]}}}], "expect": "get_stock_price"}
{"kind": "tool", "id": "t12", "prompt": "Run the unit tests of the module billing with verbose output.", "tools": [{"type": "function", "function": {"name": "run_tests", "description": "Run a test suite", "parameters": {"type": "object", "properties": {"module": {"type": "string", "description": "Module name"}, "verbose": {"type": "boolean", "description": "Verbose output"}}, "required": ["module"]}}}], "expect": "run_tests"}
